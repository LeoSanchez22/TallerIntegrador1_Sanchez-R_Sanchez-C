# =====================================================================
# CONFIGURACIÓN CLOUD - SUPABASE Y MLOps (.env.example)
# =====================================================================
# NOTA: Renombra este archivo a ".env" e ingresa tus contraseñas reales.

# 1. Cadena de Conexión Directa de PostgreSQL (Backend Hono)
DATABASE_URL="postgresql://usuario:contraseña@servidor.supabase.com:6543/postgres"

# 2. Credenciales de Supabase Auth (Frontend Next.js)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_anon_key"
SUPABASE_JWT_SECRET="tu_jwt_secret_de_supabase_settings_api"

# 3. Puerto del Servidor Backend (Rango permitido VPS: 5000-5999)
PORT=5005

# 4. Sincronización Automática de Modelos (.pt) desde Jupyter/Colab a Producción
MODEL_UPLOAD_TOKEN="ingresa_aqui_tu_token_seguro_de_subida"
DEPLOYMENT_SERVER_URL="https://tu-dominio-de-produccion.com"

# =====================================================================
# CONTROLES DE SEGURIDAD (RF-11, RF-16, RF-17, RNF-11, RNF-12, RNF-13, RNF-14)
# Ver SECURITY.md para la matriz de trazabilidad de requerimientos.
# =====================================================================

# --- RF-17 · Cierre de sesión automático por inactividad (minutos) ---
# Backend Hono (idleSessionGuard) y Frontend Next.js (useSessionTimeout).
SESSION_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=30
# Aviso previo mostrado al usuario antes de cerrar la sesión (minutos).
NEXT_PUBLIC_SESSION_IDLE_WARNING_MINUTES=2

# --- RNF-14 · Limitación de tasa (rate limiting) del API Gateway ---
# Ventana deslizante en milisegundos y máximo de peticiones por ventana.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MODEL_MAX=30
# Ventana y máximo del microservicio FastAPI (por IP y ruta).
RATE_LIMIT_ML_WINDOW_MS=60000
RATE_LIMIT_ML_MAX=60
# Desactiva el rate limiting SOLO en pruebas automatizadas.
ML_DISABLE_RATE_LIMIT=false

# --- RNF-14 · Control de origen (CORS): lista blanca por comas ---
ALLOWED_ORIGINS="https://tallerintegrador1.diegoproyectos.me:5002,https://taller2.diegoproyectos.me:5002,http://localhost:3000"

# --- RNF-13 · Límite máximo del cuerpo de la petición (bytes) ---
MAX_REQUEST_BODY_BYTES=1048576

# --- RNF-11 · TLS hacia PostgreSQL/Supabase ---
# Por defecto la verificación del certificado está ACTIVA (rechaza certificados
# autofirmados). En local, si tu red intercepta el TLS, define:
# PG_SSL_REJECT_UNAUTHORIZED=false  (SOLO desarrollo, nunca en producción)

# --- RF-11 / RF-16 · Comunicación servicio-a-servicio con el microservicio IA ---
# Si se define, el API Gateway inyecta X-Service-Key en cada llamada a FastAPI
# y FastAPI rechaza con HTTP 401 cualquier petición sin la clave.
ML_SERVICE_KEY=""
FASTAPI_URL="http://127.0.0.1:8000"
ML_TIMEOUT_MS=15000
